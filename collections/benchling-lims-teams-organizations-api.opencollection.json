{
  "opencollection": "1.0.0",
  "info": {
    "name": "Benchling AA Sequences Teams & Organizations API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams & Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.benchling.com/api/v2/users"
          },
          "docs": "List users"
        },
        {
          "info": {
            "name": "Create a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.benchling.com/api/v2/users"
          },
          "docs": "Create a user"
        },
        {
          "info": {
            "name": "List teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.benchling.com/api/v2/teams"
          },
          "docs": "List teams"
        },
        {
          "info": {
            "name": "List team memberships",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.benchling.com/api/v2/teams/:team_id/memberships",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List team memberships"
        },
        {
          "info": {
            "name": "List organizations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.benchling.com/api/v2/organizations"
          },
          "docs": "List organizations"
        }
      ]
    }
  ],
  "bundled": true
}